# Public origin, without /api/v1. Backend must allow this frontend origin in CORS.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Set live for actual API calls. Mock is a labeled synthetic contract demonstration.
NEXT_PUBLIC_API_MODE=mock
# Optional comma-separated exact hosts only after the backend curator reviews ownership.
# gov.in and nic.in source links are permitted by default; this does not certify policy.
NEXT_PUBLIC_REVIEWED_OFFICIAL_HOSTS=
