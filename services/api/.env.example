APP_ENV=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000
SESSION_TTL_HOURS=24
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/yojana_saathi
# Configure separate 32+ character secrets and non-sensitive actor IDs to enable admin APIs.
ADMIN_REVIEW_TOKEN=
ADMIN_REVIEWER_ID=
ADMIN_PUBLISH_TOKEN=
ADMIN_PUBLISHER_ID=
# Gemini (server-only). GEMINI_EMBEDDING_MODEL enables curator staging search, e.g. gemini-embedding-001.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=
# Sarvam speech (server-only): https://dashboard.sarvam.ai/
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TRANSLATION_MODEL=sarvam-translate:v1
SARVAM_CHAT_MODEL=sarvam-105b-conversations
