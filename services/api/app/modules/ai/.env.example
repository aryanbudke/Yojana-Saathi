# Append these server-only entries to services/api/.env (never commit .env).
# Leave empty for manual profile entry; deterministic matching works without Gemini.
GEMINI_API_KEY=
# Select a model enabled in your Google project that supports structured JSON output.
# Use its short model ID, without a models/ prefix. No default is assumed.
GEMINI_MODEL=
# Extraction: en-IN only, 1000 input characters, 10-second socket timeout,
# 64000 response bytes, 2048 output tokens, 20 calls/minute per process.
# Add shared deployment rate limiting before scaling to multiple workers.
